REGEX_UPPERCASE = re.compile("[{:s}]".format("".join(string.ascii_uppercase)))
REGEX_DIGITS = re.compile("[{:s}]".format("".join(string.digits)))
REGEX_SPECIAL = re.compile("[{:s}]".format(
    re.escape("".join(string.punctuation))))

